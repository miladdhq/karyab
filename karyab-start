#!/usr/bin/env bash
# Start karyab and open it in the browser.
# Safe to run twice: if it is already up, this just opens the tab.
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${KARYAB_PORT:-8765}"
URL="http://127.0.0.1:$PORT"
PIDFILE="$HERE/.karyab.pid"
LOG="$HERE/.karyab-server.log"

# karlancer.com is an Iranian domestic site and this server is local. The
# system SOCKS proxy breaks both, so it is dropped for this process only.
unset ALL_PROXY all_proxy HTTP_PROXY http_proxy HTTPS_PROXY https_proxy

is_up() {
  "$HERE/.venv/bin/python" - "$URL" <<'PY' 2>/dev/null
import sys, urllib.request
try:
    urllib.request.urlopen(sys.argv[1], timeout=1)
except Exception:
    sys.exit(1)
PY
}

if is_up; then
  # Adopt it, so karyab-stop can find a server this script did not start.
  if command -v ss >/dev/null 2>&1; then
    ss -tlnpH "sport = :$PORT" 2>/dev/null |
      grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2 > "$PIDFILE" 2>/dev/null || true
  fi
  echo "karyab is already running."
else
  echo "Starting karyab..."
  nohup "$HERE/.venv/bin/python" -m karyab.cli review --port "$PORT" >"$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  for _ in $(seq 1 40); do is_up && break; sleep 0.25; done
  if ! is_up; then
    echo "karyab did not start. Last lines of $LOG:" >&2
    tail -15 "$LOG" >&2
    exit 1
  fi
fi

# Refresh the app-menu entry so it always points at THIS checkout.
DESK="$HOME/.local/share/applications/karyab.desktop"
if [ ! -f "$DESK" ] || ! grep -q "Exec=$HERE/karyab-start" "$DESK" 2>/dev/null; then
  mkdir -p "$(dirname "$DESK")"
  printf '[Desktop Entry]\nType=Application\nName=کاریاب — Karyab\nComment=Review freelance proposals from karlancer.com\nExec=%s/karyab-start\nIcon=applications-development\nTerminal=false\nCategories=Development;\n' "$HERE" > "$DESK"
  update-desktop-database "$(dirname "$DESK")" 2>/dev/null || true
fi

echo "Open: $URL"
command -v xdg-open >/dev/null && (xdg-open "$URL" >/dev/null 2>&1 &)
